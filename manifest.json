{
  "manifest_version": 3,
  "name": "PromptCanvas — AI Theme & Prompt Engine for ChatGPT",
  "version": "1.0.0",
  "description": "A modern UI & custom theme engine for ChatGPT. Inject stunning themes, manage prompt libraries, and supercharge your AI workflow.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "common/utils/color.js",
        "common/utils/dom.js",
        "common/constants/wallpapers.js",
        "common/constants/themes.js",
        "common/constants/defaults.js",
        "content/modules/icons.js",
        "content/modules/wallpaper-engine.js",
        "content/modules/theme-css/tokens.js",
        "content/modules/theme-css/layout.js",
        "content/modules/theme-css/sidebar.js",
        "content/modules/theme-css/messages.js",
        "content/modules/theme-css/composer.js",
        "content/modules/theme-css/dialogs.js",
        "content/modules/theme-css/starters.js",
        "content/modules/theme-css/codeblocks.js",
        "content/modules/theme-css/index.js",
        "content/modules/theme-engine.js",
        "content/modules/composer.js",
        "sidebar/components/templates.js",
        "sidebar/sidebar.js",
        "content/content.js"
      ],
      "css": [
        "sidebar/sidebar.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "common/*",
        "content/*",
        "sidebar/*",
        "icons/*",
        "options/*",
        "assets/*"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}